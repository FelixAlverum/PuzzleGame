{
  "name": "spielesammlung",
  "private": true,
  "description": "Spielesammlung im Browser (Arbeitstitel): Bibliothek mehrerer Spiele mit gemeinsamem Konto",
  "type": "module",
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @spielesammlung/web",
    "build": "npm run build -w @spielesammlung/web",
    "preview": "npm run preview -w @spielesammlung/web",
    "dev:cozy-garden": "npm run dev -w @spielesammlung/cozy-garden",
    "dev:minesweeper": "npm run dev -w @spielesammlung/minesweeper",
    "dev:solitaire": "npm run dev -w @spielesammlung/solitaire",
    "dev:spider": "npm run dev -w @spielesammlung/spider",
    "test": "node --test \"games/*/tests/*.test.js\" \"apps/*/tests/*.test.js\" \"packages/*/tests/*.test.js\"",
    "test:e2e": "playwright test -c apps/web/playwright.config.js",
    "typecheck": "tsc -p packages/game-sdk"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
